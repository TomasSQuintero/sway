set render-loading "false"
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
unmap i
map i recolor
map [fullscreen] i recolor
map { navigate previous
map } navigate next
unmap j
unmap k
unmap h
unmap l
# jk for next/prev
map j navigate next
map k navigate previous
map h scroll down
map l scroll up
map [fullscreen] j navigate next
map [fullscreen] k navigate previous
map [fullscreen] h scroll down
map [fullscreen] l scroll up
# # jk to scroll
